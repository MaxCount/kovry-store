# Скопируйте в .env.local и подставьте данные вашего проекта Sanity.
# Пока переменные не заданы — сайт работает на встроенных демо-данных.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Необязательно: секрет для мгновенного обновления кэша через вебхук Sanity.
SANITY_REVALIDATE_SECRET=
